---
// src/pages/about.astro
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="About" section="about">
  <div class="page-header">
    <h1>About</h1>
  </div>

  <div class="prose">
    <p>
      I'm a 22 year old Cyber Security analyst from Jersey with 
      experience at CSIRTs and corpo environments. My personal 
      interest are motorsports, permacomputing and self-hosting.
      <br/>

      <h2>Work Experience</h2>

      <p>My previous work experience includes:</p>

      <ul>
        <li>Security Operations - 3 months</li>
        <li>Service Desk - 7 months</li>
        <li>Security Analyst - 6 months</li>
      </ul>

      <h2>Technical</h2>

      <p>
        I have programming experience in HTML, CSS, JS, Python, Nix, Astro 
        as well as experience in Active Directory, Unix systems and incident response.
      </p>

      <p>
        This website is built with <a href="https://astro.build" target="_blank" rel="noopener"
          >Astro.js</a
        >. Content written in Markdown. Deployed as static HTML. Source code is
        <a
          href="https://www.github.com/tmangan64/BlackwallSite"
          target="_blank"
          rel="noopener">here</a
        >.
      </p>

      <h2></h2>
    </p>
  </div>
</BaseLayout>
